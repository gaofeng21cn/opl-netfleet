{
  "schema_version": "opl.product-release.v1",
  "product_id": "opl-netfleet",
  "repository": "gaofeng21cn/opl-netfleet",
  "strategy": "daily_patch",
  "trigger": "tag",
  "tag_prefix": "v",
  "publisher_workflow": "release.yml",
  "publisher_title_from_tag": "OpenWrt release {tag}",
  "primary_lane": "openwrt",
  "observed_publishers": [
    {
      "lane": "macos-candidate",
      "workflow": "macos-sparkle-release.yml",
      "match": "tag"
    },
    {
      "lane": "macos-stable",
      "workflow": "macos-sparkle-publish.yml",
      "channel": {
        "kind": "sparkle",
        "asset": "appcast.xml",
        "release_tag": "macos-stable"
      }
    }
  ],
  "channel": {
    "kind": "github_release"
  },
  "version_file": {
    "path": "product-version.json",
    "kind": "json"
  },
  "version_files": [
    {
      "path": "product-version.json",
      "kind": "json"
    },
    {
      "path": "desktop/app/Info.plist",
      "kind": "plist_bundle"
    }
  ],
  "release_paths": [
    "openwrt",
    "plugins",
    "ui",
    "desktop",
    "scripts",
    ":(exclude,glob)scripts/openwrt-vm/guest-*.sh",
    "sdk",
    "product-version.json",
    ".github/workflows/release.yml",
    ".github/workflows/netfleet-openwrt-candidate.yml",
    ".github/workflows/macos-sparkle-release.yml",
    ".github/workflows/macos-sparkle-publish.yml"
  ],
  "prepare": [
    [
      "python3",
      "scripts/prepare-product-release.py"
    ]
  ],
  "verify": []
}
