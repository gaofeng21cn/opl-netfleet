#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=04

start_service() {
	[ -f /etc/opl-netfleet/compatibility/config.json ] || return 0
	[ "$(jsonfilter -i /etc/opl-netfleet/compatibility/config.json -e '@.enabled')" = true ] || return 0
	[ -f /var/run/opl-netfleet-compat/effective.json ] || /usr/bin/python3 /usr/libexec/opl-netfleet-compat/control.py prepare >/dev/null || return 1
	procd_open_instance engine
	procd_set_param command /usr/bin/python3 /usr/libexec/opl-netfleet-compat/control.py run
	# Recovery owns the bounded fault window and manual latch. Keep procd from
	# imposing a smaller restart budget that strands a healthy plugin after
	# repeated, controlled engine failures.
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param term_timeout 5
	procd_close_instance
	procd_open_instance manager
	procd_set_param command /usr/bin/python3 /usr/libexec/opl-netfleet-compat/control.py watch
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param limits nofile="128 128" core="0 0"
	procd_set_param term_timeout 5
	procd_close_instance
}

stop_service() {
	# rc.common would otherwise kill procd's instance even when this hook fails.
	/usr/bin/python3 /usr/libexec/opl-netfleet-compat/control.py drain >/dev/null || exit 1
}
