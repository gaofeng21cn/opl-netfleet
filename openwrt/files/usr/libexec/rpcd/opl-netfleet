#!/bin/sh

main=/usr/libexec/opl-netfleet/main.uc
components=/usr/libexec/opl-netfleet/application/components.uc
lock=/var/lock/opl-netfleet-deploy.lock

lock_mutation() {
	exec 9>"$lock"
	if ! flock -n 9; then
		printf '%s\n' '{"ok":false,"error":"mutation_busy"}'
		exit 0
	fi
}

respond_owner() {
	output=$("$@")
	status=$?
	if [ -n "$output" ]; then
		printf '%s\n' "$output"
	else
		printf '{"ok":false,"error":"owner_no_response","exit_code":%s}\n' "$status"
	fi
	exit 0
}

enable_current_policy() {
	lock_mutation
	if ! compile_output=$(ucode "$main" compile 9>&-); then
		printf '%s\n' "$compile_output"
		exit 0
	fi
	respond_owner ucode "$main" enable luci 9>&-
}

select_automatic() {
	payload=$(cat)
	capability=$(jsonfilter -s "$payload" -e '@.capability' 2>/dev/null || true)
	case "$capability" in
		""|*[!A-Za-z0-9._-]*)
			printf '%s\n' '{"ok":false,"error":"invalid_capability"}'
			exit 0
			;;
	esac
	lock_mutation
	respond_owner ucode "$main" select "$capability" auto luci 9>&-
}

config_request() {
	action=$1
	mutating=$2
	payload=$(cat)
	[ "${#payload}" -le 65536 ] || {
		printf '%s\n' '{"ok":false,"error":"config_request_too_large"}'
		exit 0
	}
	umask 077
	temporary="/tmp/opl-netfleet-${action}.$$"
	trap 'rm -f "$temporary"' EXIT INT TERM
	printf '%s' "$payload" >"$temporary" || {
		printf '%s\n' '{"ok":false,"error":"config_request_unreadable"}'
		exit 0
	}
	[ "$mutating" = "1" ] && lock_mutation
	respond_owner ucode "$main" "$action" "$temporary" 9>&-
}

component_update() {
	payload=$(cat)
	[ "${#payload}" -le 1024 ] || {
		printf '%s\n' '{"ok":false,"error":"invalid_component_request"}'
		exit 0
	}
	component=$(jsonfilter -s "$payload" -e '@.component' 2>/dev/null || true)
	version=$(jsonfilter -s "$payload" -e '@.version' 2>/dev/null || true)
	case "$component" in netfleet|mihomo) ;; *) printf '%s\n' '{"ok":false,"error":"invalid_component_request"}'; exit 0 ;; esac
	case "$version" in ""|-*|*[!A-Za-z0-9._+~:-]*) printf '%s\n' '{"ok":false,"error":"invalid_component_request"}'; exit 0 ;; esac
	lock_mutation
	respond_owner ucode "$components" update "$component" "$version" 9>&-
}

case "$1" in
	list)
		printf '%s\n' '{"compatibility_get":{},"compatibility_ca":{},"compatibility_apply":{"request":"Table"},"compatibility_enable":{"request":"Table"},"compatibility_disable":{"request":"Table"},"compatibility_probe":{"request":"Table"},"components_get":{},"components_check":{},"components_update":{"component":"String","version":"String"},"operation_get":{},"native_setup_get":{},"native_setup_apply":{"request":"Table"},"dashboard_get":{},"subscriptions_get":{},"subscriptions_set":{"request":"Table"},"subscriptions_refresh":{"id":"String"},"migration_get":{},"migration_apply":{"request":"Table"},"onboarding_get":{},"onboarding_apply":{"request":"Table"},"status":{},"events":{},"connections":{},"probe":{},"config_get":{},"config_validate":{"request":"Table"},"config_save":{"request":"Table"},"config_apply":{"request":"Table"},"enable":{},"select_auto":{"capability":"String"},"refresh":{},"disable":{}}'
		;;
	call)
		case "$2" in
			compatibility_get) respond_owner ucode "$main" compatibility-get ;;
			compatibility_ca) respond_owner ucode "$main" compatibility-ca ;;
			compatibility_apply) config_request compatibility-apply 0 ;;
			compatibility_enable) config_request compatibility-enable 0 ;;
			compatibility_disable) config_request compatibility-disable 0 ;;
			compatibility_probe) config_request compatibility-probe 0 ;;
			components_get) respond_owner ucode "$components" get ;;
			operation_get) respond_owner ucode "$components" operation ;;
			components_check)
				lock_mutation
				respond_owner ucode "$components" check 9>&-
				;;
			components_update) component_update ;;
			subscriptions_refresh)
				payload=$(cat)
				id=$(jsonfilter -s "$payload" -e '@.id' 2>/dev/null || true)
				case "$id" in ""|*[!A-Za-z0-9_]*) printf '%s\n' '{"ok":false,"error":"invalid_subscription_id"}'; exit 0 ;; esac
				lock_mutation
				respond_owner ucode "$main" subscriptions-refresh "$id" luci 9>&-
				;;
			native_setup_get) respond_owner ucode "$main" native-setup-get ;;
			native_setup_apply) config_request native-setup-apply 1 ;;
			dashboard_get) respond_owner ucode "$main" dashboard-get ;;
			subscriptions_get) respond_owner ucode "$main" subscriptions-get ;;
			subscriptions_set) config_request subscriptions-set 1 ;;
			migration_get) respond_owner ucode "$main" migration-get ;;
			migration_apply) config_request migration-apply 1 ;;
			onboarding_get)
				respond_owner ucode "$main" onboarding-get
				;;
			onboarding_apply)
				config_request onboarding-apply 1
				;;
			status)
				respond_owner ucode "$main" status
				;;
				events)
					respond_owner ucode "$main" events
					;;
				connections)
					respond_owner ucode "$main" connections
					;;
				probe)
					respond_owner ucode "$main" probe
					;;
				config_get)
					exec ucode "$main" config-get
					;;
				config_validate)
					config_request config-validate 0
					;;
				config_save)
					config_request config-save 1
					;;
				config_apply)
					config_request config-apply 1
					;;
			enable)
				enable_current_policy
				;;
			select_auto)
				select_automatic
				;;
			refresh)
				lock_mutation
				respond_owner ucode "$main" refresh luci 9>&-
				;;
			disable)
				lock_mutation
				respond_owner ucode "$main" disable luci 9>&-
				;;
			*)
				printf '%s\n' '{"ok":false,"error":"unknown_method"}'
				exit 0
				;;
		esac
		;;
	*)
		printf '%s\n' '{"ok":false,"error":"invalid_rpcd_invocation"}'
		exit 0
		;;
esac
