{
  "schema": "opl-netfleet-service-plugin.v1",
  "id": "components",
  "label": "Components and updates",
  "version": "0.8.11",
  "api_version": 1,
  "package": "opl-netfleet-plugin-components",
  "services": {
    "components.control": {
      "version": 1,
      "module": "lib/control.uc",
      "requires": {
        "dashboard.control": 1,
        "mihomo.gateway": 1,
        "events.operation": 1,
        "mihomo.controller": 1,
        "platform.files": 1,
        "platform.runtime": 1,
        "platform.storage": 1,
        "platform.process": 1,
        "platform.credentials": 1,
        "platform.paths": 1
      }
    }
  },
  "commands": {
    "components-plugin-plan": {
      "service": "components.control",
      "method": "command",
      "access": "read"
    },
    "components-plugin": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    },
    "components-cancel": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    },
    "components-get": {
      "service": "components.control",
      "method": "command",
      "access": "read"
    },
    "components-operation": {
      "service": "components.control",
      "method": "command",
      "access": "read"
    },
    "components-check": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    },
    "components-update": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    },
    "components-run": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    },
    "components-recover": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    },
    "components-install": {
      "service": "components.control",
      "method": "command",
      "access": "write"
    }
  },
  "package_dependencies": [
    "curl",
    "ca-bundle"
  ],
  "presentation": {
    "label": "组件更新",
    "description": "检查并更新基础软件与面板资源"
  },
  "product": {
    "required": true,
    "unloadable": false,
    "retained": false,
    "owner": "components",
    "packages": [
      "opl-netfleet",
      "luci-app-netfleet",
      "mihomo-meta"
    ],
    "dependencies": [
      "ucode",
      "ucode-mod-fs",
      "ucode-mod-uci",
      "ucode-mod-ubus",
      "ucode-mod-uloop",
      "yq",
      "curl",
      "ca-bundle",
      "flock",
      "unzip",
      "ip-full",
      "nftables-json",
      "kmod-nft-socket",
      "kmod-nft-tproxy"
    ]
  }
}
