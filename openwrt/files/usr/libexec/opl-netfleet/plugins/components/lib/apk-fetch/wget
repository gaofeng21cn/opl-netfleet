#!/bin/sh
# APK's wget backend protocol, scoped to the NetFleet transaction PATH.
set -eu
limit=90
destination=-
url=
while [ "$#" -gt 0 ]; do
	case "$1" in
		-q) shift ;;
		-T) limit=$2; shift 2 ;;
		-O) destination=$2; shift 2 ;;
		http://*|https://*) [ -z "$url" ] || exit 2; url=$1; shift ;;
		*) exit 2 ;;
	esac
done
case "$limit" in ''|*[!0-9]*) exit 2 ;; esac
[ "$limit" -gt 0 ] || limit=90
[ -n "$url" ] || exit 2
exec curl -q -fsSL --proto '=http,https' --proto-redir '=http,https' \
	--connect-timeout 10 --max-time "$limit" --output "$destination" "$url"
