{
  "schema": "opl-netfleet-service-plugin.v1",
  "id": "platform",
  "label": "OpenWrt platform",
  "version": "0.7.0",
  "api_version": 1,
  "package": "opl-netfleet-plugin-platform",
  "services": {
    "platform.runtime": {
      "version": 1,
      "module": "lib/runtime.uc",
      "requires": {}
    },
    "platform.uci": {
      "version": 1,
      "module": "lib/uci.uc",
      "requires": {
