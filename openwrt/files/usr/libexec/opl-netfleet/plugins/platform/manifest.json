    },
    "platform.service": {
      "version": 1,
      "module": "lib/service.uc",
      "requires": {}
    },
    "platform.documents": {
      "version": 1,
      "module": "lib/documents.uc",
      "requires": {
        "models.evidence": 1,
        "models.policy": 1,
        "platform.uci": 1
      }
    }
  },
  "commands": {},
  "package_dependencies": [
    "ucode-mod-uci",
    "yq",
    "ip-full"
