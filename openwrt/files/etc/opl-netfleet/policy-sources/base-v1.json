{
  "dns": {
    "default-nameserver": [
      "223.5.5.5",
      "119.29.29.29"
    ],
    "nameserver": [
      "https://dns.alidns.com/dns-query",
      "https://doh.pub/dns-query"
    ],
    "proxy-server-nameserver": [
      "https://dns.alidns.com/dns-query",
      "https://doh.pub/dns-query"
    ],
    "respect-rules": true,
    "nameserver-policy": {
      "rule-set:geolocation-non-cn": [
        "https://1.1.1.1/dns-query",
        "https://8.8.8.8/dns-query"
      ]
    }
  },
  "rule-providers": {
    "private-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/private-domain.mrs"},
    "private-ip": {"type": "file", "behavior": "ipcidr", "format": "mrs", "path": "/etc/nikki/run/rulesets/private-ip.mrs"},
    "ai-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/ai-domain.mrs"},
    "netflix-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/netflix-domain.mrs"},
    "netflix-ip": {"type": "file", "behavior": "ipcidr", "format": "mrs", "path": "/etc/nikki/run/rulesets/netflix-ip.mrs"},
    "youtube-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/youtube-domain.mrs"},
    "telegram-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/telegram-domain.mrs"},
    "telegram-ip": {"type": "file", "behavior": "ipcidr", "format": "mrs", "path": "/etc/nikki/run/rulesets/telegram-ip.mrs"},
    "social-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/social-domain.mrs"},
    "steam-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/steam-domain.mrs"},
    "xbox-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/xbox-domain.mrs"},
    "playstation-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/playstation-domain.mrs"},
    "nintendo-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/nintendo-domain.mrs"},
    "microsoft-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/microsoft-domain.mrs"},
    "apple-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/apple-domain.mrs"},
    "google-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/google-domain.mrs"},
    "domestic-media-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/domestic-media-domain.mrs"},
    "cn-domain": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/cn-domain.mrs"},
    "cn-ip": {"type": "file", "behavior": "ipcidr", "format": "mrs", "path": "/etc/nikki/run/rulesets/cn-ip.mrs"},
    "geolocation-non-cn": {"type": "file", "behavior": "domain", "format": "mrs", "path": "/etc/nikki/run/rulesets/geolocation-non-cn.mrs"}
  },
  "proxy-groups": [
    {"name": "海外加速", "type": "select", "proxies": ["DIRECT"]},
    {"name": "AI 出口", "type": "select", "proxies": ["DIRECT"]},
    {"name": "Netflix", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "YouTube", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "Telegram", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "社交媒体", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "Steam", "type": "select", "proxies": ["DIRECT", "海外加速"]},
    {"name": "Xbox", "type": "select", "proxies": ["DIRECT", "海外加速"]},
    {"name": "PlayStation", "type": "select", "proxies": ["DIRECT", "海外加速"]},
    {"name": "Nintendo Switch", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "微软服务", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "苹果服务", "type": "select", "proxies": ["DIRECT", "海外加速"]},
    {"name": "谷歌服务", "type": "select", "proxies": ["海外加速", "DIRECT"]},
    {"name": "国内媒体", "type": "select", "proxies": ["DIRECT", "海外加速"]}
  ],
  "rules": [
    "DOMAIN-SUFFIX,tailscale.com,DIRECT",
    "DOMAIN-SUFFIX,tailscale.io,DIRECT",
    "SRC-PORT,41641,DIRECT",
    "DST-PORT,41641,DIRECT",
    "DST-PORT,3478,DIRECT",
    "RULE-SET,private-domain,DIRECT",
    "RULE-SET,private-ip,DIRECT,no-resolve",
    "RULE-SET,ai-domain,AI 出口",
    "RULE-SET,netflix-domain,Netflix",
    "RULE-SET,netflix-ip,Netflix,no-resolve",
    "RULE-SET,youtube-domain,YouTube",
    "RULE-SET,telegram-domain,Telegram",
    "RULE-SET,telegram-ip,Telegram,no-resolve",
    "RULE-SET,social-domain,社交媒体",
    "RULE-SET,steam-domain,Steam",
    "RULE-SET,xbox-domain,Xbox",
    "RULE-SET,playstation-domain,PlayStation",
    "RULE-SET,nintendo-domain,Nintendo Switch",
    "RULE-SET,microsoft-domain,微软服务",
    "RULE-SET,apple-domain,苹果服务",
    "RULE-SET,google-domain,谷歌服务",
    "RULE-SET,domestic-media-domain,国内媒体",
    "RULE-SET,cn-domain,DIRECT",
    "RULE-SET,cn-ip,DIRECT,no-resolve",
    "RULE-SET,geolocation-non-cn,海外加速",
    "MATCH,海外加速"
  ]
}
