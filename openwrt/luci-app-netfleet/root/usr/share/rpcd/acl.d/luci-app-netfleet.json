{
  "luci-app-netfleet": {
    "description": "Discover, configure, operate, and restore NetFleet",
    "read": {
      "cgi-io": [ "exec" ],
      "ubus": {
        "opl-netfleet": ["compatibility_get","compatibility_ca","components_get","operation_get","native_setup_get","dashboard_get","subscriptions_get","migration_get","onboarding_get","status","events","connections","probe","config_get","config_validate","network_get","network_validate","maintenance_get","profile_get","diagnostics_get"]
      }
    },
    "write": {
      "cgi-io": [ "upload" ],
      "file": {
        "/usr/libexec/opl-netfleet-transfer profile-get *": [ "exec" ],
        "/usr/libexec/opl-netfleet-transfer backup-export": [ "exec" ],
        "/tmp/opl-netfleet-upload.*.json": [ "write" ]
      },
      "ubus": {
        "opl-netfleet": ["compatibility_apply","compatibility_enable","compatibility_disable","compatibility_probe","components_check","components_update","native_setup_apply","subscriptions_set","subscriptions_refresh","migration_apply","onboarding_apply","config_save","config_apply","enable","select_auto","refresh","disable","network_apply","profile_save","profile_delete","backup_export","backup_restore","core_action","dashboard_check","dashboard_update"]
      }
    }
  }
}
