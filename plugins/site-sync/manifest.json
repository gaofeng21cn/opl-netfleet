{
  "schema": "opl-netfleet-service-plugin.v1",
  "id": "site-sync",
  "label": "Cloud site sync",
  "version": "0.1.0",
  "api_version": 1,
  "package": "opl-netfleet-plugin-site-sync",
  "services": {
    "site-sync.control": {
      "version": 1,
      "module": "lib/control.uc",
      "requires": {
        "events.store": 1,
        "mihomo.controller": 1,
        "platform.credentials": 1,
        "platform.process": 1,
        "platform.storage": 1,
        "platform.files": 1,
        "refresh.control": 1
      }
    }
  },
  "commands": {
    "site-sync-heartbeat": {
      "service": "site-sync.control",
      "method": "command_heartbeat",
      "access": "write"
    },
    "site-sync-apply": {
      "service": "site-sync.control",
      "method": "command_apply",
      "access": "write"
    }
  },
  "package_dependencies": [
    "curl",
    "ca-bundle"
  ],
  "presentation": {
    "label": "云端站点同步",
    "description": "可选地上报脱敏状态并按 revision 同步订阅"
  },
  "product": {
    "required": false,
    "unloadable": true,
    "retained": false,
    "owner": "site-sync"
  }
}
